# Py-Buddy — environment configuration template
# Copy to `.env` and fill in. `.env` is git-ignored and the pre-commit hook
# (scripts/check_secrets.py) blocks any commit that contains a real key.

# --- OpenRouter ---------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model used by the ReAct planner and by the retrieval baseline.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional: comma-separated models tried in order when the primary is
# rate-limited. The free tier is heavily throttled, so a pool keeps a long
# benchmark run from stalling.
OPENROUTER_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,cohere/north-mini-code:free,liquid/lfm-2.5-2.6b:free

# --- Optional services ---------------------------------------------------
# REDIS_URL=redis://localhost:6379/0   # enables RedisVectorStore in the
#                                      # semantic intent cache; falls back to
#                                      # LocalMemoryVectorStore when unset
